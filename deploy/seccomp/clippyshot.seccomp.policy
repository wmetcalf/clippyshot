// ClippyShot seccomp policy (nsjail KAFEL DSL).
//
// DENYLIST style: DEFAULT ALLOW + explicit ERRNO(1) on dangerous syscalls.
// Same philosophy Docker and Kubernetes use for their default seccomp
// profile. The security is defense-in-depth behind:
//   1. the outer container's namespace+cgroup isolation
//   2. the bwrap/nsjail user-namespace + network-namespace + cap-drop
//   3. the clippyshot-soffice AppArmor profile
//   4. the hardened LibreOffice user profile (DisableMacrosExecution)
//
// Flipping from allowlist to denylist avoids the whack-a-mole where a new
// LibreOffice version (or any new glibc) introduces a syscall we didn't
// explicitly permit, causing silent SIGSYS at startup.
//
// Loaded by src/clippyshot/sandbox/nsjail.py and passed inline via --seccomp_string.
// Deployed into the runtime image at /etc/clippyshot/seccomp.policy.
//
// KAFEL caveats: the kafel bundled with nsjail knows only the syscalls up to
// roughly Linux 4.x (its amd64 table stops before statx), and an unknown name
// fails the WHOLE policy. Anything newer is written by number with its name in
// a trailing comment: `SYSCALL[425],  // io_uring_setup`. The image build and
// tests/docker/test_inner_seccomp.py compile this file with the shipped nsjail.
//
// Syntax reference: https://github.com/google/kafel

POLICY clippyshot_deny {
  ERRNO(1) {
    // Kernel module loading
    init_module,
    finit_module,
    delete_module,

    // Key management
    add_key,
    keyctl,
    request_key,

    // Mount / filesystem manipulation
    mount,
    umount,
    pivot_root,
    chroot,
    SYSCALL[472],  // fchroot

    // The new mount API (Linux 5.2+): builds and attaches mounts without mount(2). By NUMBER,
    // not name: an nsjail whose bundled kafel predates a name (open_tree_attr is Linux 6.15)
    // would fail to compile the whole policy. Unified asm-generic numbers, same on aarch64.
    SYSCALL[428],  // open_tree
    SYSCALL[429],  // move_mount
    SYSCALL[430],  // fsopen
    SYSCALL[431],  // fsconfig
    SYSCALL[432],  // fsmount
    SYSCALL[433],  // fspick
    SYSCALL[442],  // mount_setattr
    SYSCALL[467],  // open_tree_attr

    // Kernel exec / reboot
    kexec_load,
    kexec_file_load,
    reboot,

    // Process inspection/control of others
    ptrace,
    process_vm_readv,
    process_vm_writev,

    // BPF / perf / tracing
    bpf,
    perf_event_open,

    // io_uring — prolific attack surface; LO doesn't use it. By NUMBER: the kafel bundled
    // with nsjail 3.4 has no io_uring names, and ONE unknown name fails the whole policy --
    // nsjail then exits 255 ("Couldn't prepare sandboxing policy") on every run.
    SYSCALL[425],  // io_uring_setup
    SYSCALL[426],  // io_uring_enter
    SYSCALL[427],  // io_uring_register

    // Userfaultfd (fault-injection primitives)
    userfaultfd,

    // Clock manipulation
    clock_settime,
    clock_adjtime,
    settimeofday,
    adjtimex,

    // Host identity
    sethostname,
    setdomainname,

    // Namespace creation (we're already namespaced)
    unshare,

    // Dangerous system controls
    quotactl,
    vhangup,
    nfsservctl,
    name_to_handle_at,
    open_by_handle_at,
    swapon,
    swapoff,

    // Obscure cross-task primitives
    kcmp,

    // Legacy / deprecated
    uselib,
    sysfs,

    // x86 port-IO and local descriptor table
    iopl,
    ioperm,
    modify_ldt,

    // fanotify — privileged filesystem notification
    fanotify_init,
    fanotify_mark
  }
}

// The same calls under the x32 ABI (syscall number | 0x40000000). kafel emits only an
// AUDIT_ARCH check and exact-number compares, and x32 syscalls carry AUDIT_ARCH_X86_64, so
// without these a jailed process could call e.g. mount as 0x400000a5 on a kernel built with
// CONFIG_X86_X32_ABI. The bwrap BPF kills every x32 call instead (seccomp_denylist.py).
// Four of the denied calls have an x32-only number too (ptrace, kexec_load,
// process_vm_readv/writev at 521/528/539/540). Generated from seccomp_denylist; a test
// (tests/unit/test_seccomp_fail_closed.py) keeps it complete.
POLICY clippyshot_deny_x32 {
  ERRNO(1) {
    SYSCALL[0x400000af],  // x32 init_module
    SYSCALL[0x40000139],  // x32 finit_module
    SYSCALL[0x400000b0],  // x32 delete_module
    SYSCALL[0x400000f8],  // x32 add_key
    SYSCALL[0x400000fa],  // x32 keyctl
    SYSCALL[0x400000f9],  // x32 request_key
    SYSCALL[0x400000a5],  // x32 mount
    SYSCALL[0x400000a6],  // x32 umount2
    SYSCALL[0x4000009b],  // x32 pivot_root
    SYSCALL[0x400000a1],  // x32 chroot
    SYSCALL[0x400001d8],  // x32 fchroot
    SYSCALL[0x400001ae],  // x32 fsopen
    SYSCALL[0x400001af],  // x32 fsconfig
    SYSCALL[0x400001b0],  // x32 fsmount
    SYSCALL[0x400001b1],  // x32 fspick
    SYSCALL[0x400001ad],  // x32 move_mount
    SYSCALL[0x400001ac],  // x32 open_tree
    SYSCALL[0x400001d3],  // x32 open_tree_attr
    SYSCALL[0x400001ba],  // x32 mount_setattr
    SYSCALL[0x400000f6],  // x32 kexec_load
    SYSCALL[0x40000210],  // x32 kexec_load (x32-only number)
    SYSCALL[0x40000140],  // x32 kexec_file_load
    SYSCALL[0x400000a9],  // x32 reboot
    SYSCALL[0x40000065],  // x32 ptrace
    SYSCALL[0x40000209],  // x32 ptrace (x32-only number)
    SYSCALL[0x40000136],  // x32 process_vm_readv
    SYSCALL[0x4000021b],  // x32 process_vm_readv (x32-only number)
    SYSCALL[0x40000137],  // x32 process_vm_writev
    SYSCALL[0x4000021c],  // x32 process_vm_writev (x32-only number)
    SYSCALL[0x40000141],  // x32 bpf
    SYSCALL[0x4000012a],  // x32 perf_event_open
    SYSCALL[0x400001a9],  // x32 io_uring_setup
    SYSCALL[0x400001aa],  // x32 io_uring_enter
    SYSCALL[0x400001ab],  // x32 io_uring_register
    SYSCALL[0x40000143],  // x32 userfaultfd
    SYSCALL[0x400000e3],  // x32 clock_settime
    SYSCALL[0x40000131],  // x32 clock_adjtime
    SYSCALL[0x400000a4],  // x32 settimeofday
    SYSCALL[0x4000009f],  // x32 adjtimex
    SYSCALL[0x400000aa],  // x32 sethostname
    SYSCALL[0x400000ab],  // x32 setdomainname
    SYSCALL[0x40000110],  // x32 unshare
    SYSCALL[0x400000b3],  // x32 quotactl
    SYSCALL[0x40000099],  // x32 vhangup
    SYSCALL[0x400000b4],  // x32 nfsservctl
    SYSCALL[0x4000012f],  // x32 name_to_handle_at
    SYSCALL[0x40000130],  // x32 open_by_handle_at
    SYSCALL[0x400000a7],  // x32 swapon
    SYSCALL[0x400000a8],  // x32 swapoff
    SYSCALL[0x40000138],  // x32 kcmp
    SYSCALL[0x40000086],  // x32 uselib
    SYSCALL[0x4000008b],  // x32 sysfs
    SYSCALL[0x400000ac],  // x32 iopl
    SYSCALL[0x400000ad],  // x32 ioperm
    SYSCALL[0x4000009a],  // x32 modify_ldt
    SYSCALL[0x4000012c],  // x32 fanotify_init
    SYSCALL[0x4000012d]   // x32 fanotify_mark
  }
}

// kafel's top-level USE takes one policy; combine the two here.
POLICY clippyshot {
  USE clippyshot_deny,
  USE clippyshot_deny_x32
}

USE clippyshot DEFAULT ALLOW
